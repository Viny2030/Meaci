# ── BASE DE DATOS ─────────────────────────────────────────────────────────────
# Local (SQLite, sin instalar nada):
DATABASE_URL=sqlite:///./meaci_local.db

# Local con PostgreSQL:
# DATABASE_URL=postgresql://usuario:password@localhost:5432/meaci

# Railway (lo genera automático al agregar el plugin PostgreSQL):
# DATABASE_URL=postgresql://postgres:xxxx@monorail.proxy.rlwy.net:PORT/railway

# ── SEGURIDAD ────────────────────────────────────────────────────────────────
# Token para el endpoint POST /refresh (regenerar datos)
REFRESH_TOKEN=dev

# ── URLS DE LAS OTRAS PLATAFORMAS (para inyectar alertas) ────────────────────
# Dejar en blanco si no están disponibles — el MEACI funciona igual sin ellas
CONTRATOS_V2_API_URL=https://monitorcontratos-production.up.railway.app
CONTRATOS_V1_API_URL=https://gobbocomprartgn-production.up.railway.app
EJECUTIVO_API_URL=https://jefaturagabinete-production.up.railway.app
IRI_API_URL=https://monitor-production-f053.up.railway.app
MAPA_API_URL=https://mapatransparencia-production.up.railway.app
